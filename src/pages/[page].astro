---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import ResumePreview from '../components/ResumePreview.astro';
import {examples,articles} from '../data/content';
import {reactiveTemplates as templates} from '../data/templates';
export function getStaticPaths(){return ['templates','advice','documents','checker','about','privacy','help'].map(page=>({params:{page}}));}
const {page}=Astro.params;
const headings:Record<string,[string,string,string]>={templates:['Resume templates','Free resume templates for your next role.','Choose from 15 layouts or start with a role-specific fill-in template. Edit in your browser and download PDF or DOCX for free.'],advice:['Career advice','Resume advice for the question in front of you.','Find practical answers about skills, summaries, page length, formatting, and work history. Then apply the advice to your draft.'],documents:['My documents','Your next chapter, in progress.','Your documents are saved in this browser. Export a backup to keep them with you.'],checker:['Resume checker','A fresh pair of eyes.','Import a PDF, DOCX, or TXT resume and check clarity, completeness, and relevant keywords. Everything runs in your browser.'],about:['About','Big ambitions. A little help.','Resumv helps you put your experience into words and take your next step.'],privacy:['Privacy','Your story stays yours.','Your documents belong to you. Here is how this website handles them.'],help:['Help','Let’s get you moving.','A few answers to help you make the most of resumv.']};
const [active,title,subtitle]=headings[page!];
---
<Layout title={page==='advice'?'Resume Advice & Practical Writing Guides':page==='templates'?'Free Resume Templates by Job — PDF & DOCX':active} description={subtitle} active={active} noindex={page==='documents'}><div class="page-wrap"><header class="page-heading"><span class="eyebrow">MAKE YOUR NEXT MOVE</span><h1>{title}</h1><p>{subtitle}</p></header>
{page==='templates'&&<><section class="seo-section" style="margin-top:0"><h2>Find a template for your role</h2><p>A blank section plan, role-specific prompts, and a completed example to compare.</p><div class="topic-links">{examples.map(e=><a href={`/templates/${e.slug}/`}>{e.title}</a>)}</div></section><section class="seo-section"><h2>Or choose a visual layout</h2></section><div class="filter-row"><button class="filter active" data-filter="all">All templates</button>{['professional','modern','creative','simple'].map(x=><button class="filter" data-filter={x}>{x[0].toUpperCase()+x.slice(1)}</button>)}</div><div class="template-grid catalog-grid">{templates.map(t=><a href={`/builder/?template=${t.id}`} class="template-card" data-category={t.category}><div class:list={['template-stage',`stage-${t.id}`]}><img class="upstream-preview" src={`/templates/${t.id}.jpg`} alt={`${t.name} resume template`} loading="lazy" width="600" height="848"/><span class="template-use">Make it yours ↗</span></div><div class="template-caption"><div><h3>{t.name}</h3><p>{t.description}</p></div></div></a>)}</div><div class="notice">15 original Reactive Resume templates with the complete upstream David Kowalski sample, adapted under the MIT License. Previews show the first page; the editor loads all sections and pages. Customize the content, layout, typography, and colors, then download your document.</div></>}
{page==='advice'&&<div class="cards-grid">{articles.map(a=><a href={`/advice/${a.slug}/`} class="content-card"><span class="card-tag">{a.category}</span><h2>{a.title}</h2><p>{a.intro}</p><span class="card-link">{a.read} ↗</span></a>)}</div>}
{page==='documents'&&<><div class="toolbar"><a class="button primary" href="/builder/?new=1">New resume +</a><a class="button secondary" href="/cover-letter/?new=1">New cover letter</a><label class="button secondary" for="import-backup">Import backup <Icon name="upload"/></label><input type="file" id="import-backup" accept="application/json,.json" hidden/></div><div id="documents-list" class="cards-grid"></div><div id="documents-empty" class="empty-state" hidden><Icon name="folder"/><h2>Your first chapter is waiting.</h2><p>Create a resume and it will appear here automatically.</p><a class="button primary" href="/builder/">Create my resume</a></div><dialog id="delete-dialog" class="dialog"><h2>Delete this document?</h2><p>This removes the saved copy from this browser. Download a backup first if you want to keep it.</p><div class="editor-actions"><button class="button secondary" id="cancel-delete">Keep it</button><button class="button primary" id="confirm-delete">Delete document</button></div></dialog></>}
{page==='checker'&&<div class="checker-layout"><div class="editor-form"><div class="checker-import" id="check-dropzone" aria-busy="false"><span class="eyebrow">IMPORT YOUR RESUME</span><h2>Drop your resume here.</h2><p>PDF, DOCX, or TXT · Up to 10 MB</p><button type="button" class="button secondary" id="check-choose">Choose a file</button><input id="check-file" type="file" accept=".pdf,.docx,.txt,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain" hidden/><p class="hint">Processed on your device. Scanned PDFs need OCR before importing.</p></div><p id="check-import-status" class="checker-import-status" role="status" aria-live="polite"></p><label class="field-label">Your resume text<textarea id="check-text" class="field" rows="15" placeholder="Paste your resume text here…"></textarea></label><div class="toolbar"><button class="outline-button" id="check-saved">Use latest saved resume</button></div><label class="field-label">Job description (optional)<textarea id="check-job" class="field" rows="5" placeholder="Paste a job description to compare keywords…"></textarea></label><button id="run-check" class="button primary">Check my resume <Icon name="arrow"/></button><p class="hint">A local writing checklist, not an employer’s ATS score or a prediction of hiring outcomes.</p></div><div class="checker-result" id="check-result" aria-live="polite"><Icon name="check"/><h2>Small edits. Stronger story.</h2><p>Get feedback on contact information, essential sections, action words, length, and measurable results.</p><div class="notice">Your text is analyzed in this browser. Nothing is uploaded.</div></div></div>}
{page==='about'&&<article class="article"><p class="lead">The hardest part of a resume can be getting started. We make that part a little easier.</p><h2>Who publishes this site</h2><p>Resumv publishes this browser-based resume toolkit and its AI-assisted writing guides and fictional examples. We do not claim independent review by career professionals. Read our <a class="text-link" href="/editorial-policy/">editorial policy</a> or <a class="text-link" href="/contact/">send feedback</a>.</p><h2>Tools for your next chapter</h2><p>Choose a template, organize your experience, draft a cover letter, and review your writing. Resumv gives you practical tools without requiring an account or subscription.</p><h2>Built around your privacy</h2><p>Editing, suggestions, checks, and exports happen in your browser. Your documents are stored locally on this device, so download a backup if you want to move them elsewhere.</p><a class="button primary" href="/builder/">Tell your story ↗</a></article>}
{page==='privacy'&&<article class="article"><h2>Local document storage</h2><p>Resumv stores your resume and cover letter content in this browser’s local storage. We do not send your document content to a server. Other people using the same browser profile may be able to see your saved documents.</p><h2>No account or tracking scripts</h2><p>This version does not use accounts, advertising cookies, third-party analytics, or external AI services. The website host may process ordinary technical request information when serving pages.</p><h2>GitHub project link</h2><p>The header and footer request the public repository star count and latest main-branch commit from GitHub and cache them in session storage for 15 minutes. These requests send no resume content or credentials and omit the referring page URL. GitHub receives ordinary connection information such as your IP address. The project link opens GitHub in a new tab.</p><h2>You are in control</h2><p>Export a JSON backup from the editor to keep your document. Delete individual documents from My documents. Clearing browser site data removes all locally saved documents and preferences. Private browsing may discard your documents when you close the session.</p><h2>Imports and downloads</h2><p>Files you import are read locally. Resume and CV PDFs are generated in your browser; cover letters use the print dialog. Downloads are stored wherever your browser saves files. Feedback submitted to GitHub Issues is public and handled by GitHub. Do not post private resumes or credentials.</p></article>}
{page==='help'&&<article class="article">{[['How do I save a resume?','Your changes save automatically in this browser. Use My documents to return to your work. Download a JSON backup to transfer your document to another browser or device.'],['How do I download a PDF?','In the resume editor, choose Download PDF to save the exact preview. The cover letter editor still uses PDF / Print: choose Save as PDF in your browser.'],['Can I import an existing resume?','Import a resumv backup or Reactive Resume v5 JSON from the editor’s Export panel or My documents. This creates a new document. The checker accepts PDF, DOCX, and TXT files up to 10 MB and extracts their text locally for review. PDF imports are limited to 50 pages; scanned documents need OCR first. File import in the checker does not convert the document into an editable builder template.'],['Does this use AI?','No. Writing starters and resume checks use local templates and transparent rules. Edit suggestions to reflect your real experience.'],['Is it free?','Yes. All tools and exports are free. No payment details or sign-up needed.'],['How does Word export work?','The resume editor exports native .docx files in a clean, editable single-column layout. PDF preserves your selected template exactly. Cover letters currently use the older Word-compatible .doc export.'],['How do I protect my work?','Download backups regularly. Browser storage is device-specific and can be cleared. Avoid storing sensitive information on shared devices.']].map(([q,a])=><details class="content-card"><summary>{q}</summary><p>{a}</p></details>)}</article>}
</div></Layout>




