---
import Layout from '../layouts/Layout.astro';
import {examples} from '../data/content';
const title='Free Resume Builder — Edit Online & Download PDF';
const description='Create a resume with 15 templates, live PDF preview, and free PDF or DOCX downloads. No sign-up, no payment, and no upload of your resume content.';
const schema=[{'@type':'WebApplication',name:'Resumv Resume Builder',url:'https://resumv.com/resume-builder/',applicationCategory:'BusinessApplication',operatingSystem:'Web browser',browserRequirements:'Requires JavaScript and local storage',isAccessibleForFree:true,offers:{'@type':'Offer',price:'0',priceCurrency:'USD'},description}];
---
<Layout title={title} description={description} schema={schema} active="Resume builder"><div class="page-wrap"><header class="page-heading"><span class="eyebrow">WRITE. PREVIEW. MAKE YOUR NEXT MOVE.</span><h1>A free resume builder.<br/>From your first line to your final PDF.</h1><p>Choose a layout, add your own experience, and check the exact PDF as you write. Editing and downloads are free, with no account or payment step.</p></header><div class="seo-actions"><a class="button primary" href="/builder/?new=1">Build my resume ↗</a><a class="button secondary" href="/templates/">Compare templates</a></div><div class="cards-grid">{[['01','Choose your structure','Start blank or use a role-specific template. Pick the sections that best explain your experience.'],['02','Make the evidence yours','Add accurate dates, skills, and achievements. Use the example library for structure, not invented qualifications.'],['03','Preview and download','Check every page, then download PDF, editable DOCX, plain text, or a JSON backup.']].map(([n,h,p])=><section class="content-card"><span class="card-tag">{n}</span><h2>{h}</h2><p>{p}</p></section>)}</div><section class="seo-section"><h2>What is included?</h2><table class="seo-table"><tbody><tr><th>Templates</th><td>15 open-source layouts, with adjustable fonts, colors, margins, and section order.</td></tr><tr><th>Writing</th><td>Rich-text editing, optional sections, local writing starters, and undo/redo.</td></tr><tr><th>Downloads</th><td>PDF matches the live preview. DOCX uses a clean editable single-column format. JSON lets you reopen a backup.</td></tr><tr><th>Privacy</th><td>Resume content stays in this browser. There is no account sync or server-side resume storage.</td></tr><tr><th>Price</th><td>Free editing and exports. No credit card or subscription.</td></tr></tbody></table></section><section class="seo-section"><h2>Start with your kind of work</h2><div class="topic-links">{examples.filter(e=>['data-analyst','software-engineer','registered-nurse','administrative-assistant','fitness-trainer','student'].includes(e.slug)).map(e=><a href={`/templates/${e.slug}/`}>{e.title} template</a>)}</div></section><section class="seo-section"><h2>Common questions</h2><details class="content-card"><summary>Can I import an existing resume?</summary><p>You can import current Resumv JSON backups and Reactive Resume v5 JSON. PDF and Word import are not supported. You can copy your own text into the editor.</p></details><details class="content-card"><summary>Will this resume pass an ATS?</summary><p>No builder can guarantee how every employer system will process a document. Use readable text, familiar headings, accurate keywords, and the file type requested. Our checker is a writing guide, not an employer ATS rating.</p></details><details class="content-card"><summary>Where is my work saved?</summary><p>On this device, in this browser profile. Clearing browser data can remove it. Download a JSON backup to keep or transfer your work.</p></details></section><section class="seo-section"><h2>Help with the words</h2><div class="topic-links"><a href="/advice/skills-to-put-on-resume/">Skills to put on a resume</a><a href="/advice/resume-summary/">Professional summary examples</a><a href="/advice/resume-length/">How many pages should a resume be?</a><a href="/tools/resume-summary-generator/">Resume summary generator</a></div></section></div></Layout>
