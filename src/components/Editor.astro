---
import Layout from '../layouts/Layout.astro';
import {templates} from '../data/content';
const {kind='resume'}=Astro.props;
const letter=kind==='letter';
const title=letter?'Cover letter':kind==='cv'?'CV':'Resume';
---
<Layout noindex={true} title={`${title} builder`} active={letter?'Cover letters':kind==='cv'?'CV builder':'Resume builder'}><div class="page-wrap editor-page" id="editor" data-kind={kind}>
<header class="page-heading"><div><span class="eyebrow">YOUR STORY, TAKING SHAPE</span><h1>Make it yours<span class="pink">.</span></h1><span id="save-status" class="save-status" role="status">Your changes save in this browser</span></div><div class="export-group"><button class="button secondary" data-export="json">Backup</button><button class="button secondary" data-export="txt">TXT</button><button class="button secondary" data-export="doc">Word</button><button class="button primary" data-export="pdf">PDF / Print ↓</button></div></header>
<div class="toolbar"><label class="field-label" style="margin:0;flex:1">Document name<input class="field" data-field="title" placeholder={`Untitled ${title.toLowerCase()}`}/></label><label class="field-label" style="margin:0">Template<select class="field" data-field="template">{templates.map(t=><option value={t.id}>{t.name}</option>)}</select></label><label class="field-label" style="margin:0">Accent<input class="field" type="color" data-field="color" style="height:43px;width:66px;padding:6px"/></label></div>
<div class="editor-layout"><div class="editor-form">
<div class="editor-tabs" role="tablist" aria-label="Document sections">{(letter?['Details','Letter']:['Details','Experience','Education','Skills',...(kind==='cv'?['Research']:[])]).map((s,i)=><button id={`tab-${i}`} class:list={['editor-tab',{active:i===0}]} role="tab" aria-selected={i===0?'true':'false'} aria-controls={`panel-${i}`} data-tab={i}>{s}</button>)}</div>
<section id="panel-0" class="editor-panel" role="tabpanel" aria-labelledby="tab-0"><h2>Let’s start with you.</h2><p class="hint">Make it easy for the right people to reach you.</p><div class="field-grid">{[['name','Full name','e.g. Alex Morgan'],['role','Professional title','e.g. Product Designer'],['email','Email address','alex@example.com'],['phone','Phone number','+1 555 010 1234'],['location','Location','San Francisco, CA'],['website','Website or LinkedIn','linkedin.com/in/alexmorgan']].map(([key,label,placeholder])=><label class="field-label">{label}<input class="field" data-field={key} type={key==='email'?'email':'text'} placeholder={placeholder} maxlength="250"/></label>)}</div>{!letter&&<><label class="field-label">Professional summary<textarea class="field" data-field="summary" rows="6" placeholder="What do you do best? Tell your story in a few focused sentences."></textarea></label><button id="suggest-summary" class="outline-button">✦ Add a writing starter</button><p class="hint">A template to edit, based on your title and skills. Use only claims that are true for you.</p></>}{letter&&<><label class="field-label">Company<input class="field" data-field="company" placeholder="The company you’re applying to"/></label><label class="field-label">Hiring manager<input class="field" data-field="recipient" placeholder="Hiring Manager"/></label></>}</section>
{letter?<section id="panel-1" class="editor-panel" role="tabpanel" aria-labelledby="tab-1" hidden><h2>Make a meaningful introduction.</h2><label class="field-label">Your letter<textarea class="field" data-field="body" rows="18" placeholder="Explain why this role interests you, connect one achievement to the position, and close with a clear expression of interest."></textarea></label><button id="suggest-letter" class="outline-button">✦ Add a letter outline</button><p class="hint">This outline includes prompts in brackets. Replace them with your own details before sending.</p></section>:<><section id="panel-1" class="editor-panel" role="tabpanel" aria-labelledby="tab-1" hidden><h2>Show what you bring.</h2><p class="hint">Start with your most recent role. Include the impact of your work.</p><div id="experience-fields"></div><button class="outline-button" id="add-experience">+ Add experience</button></section><section id="panel-2" class="editor-panel" role="tabpanel" aria-labelledby="tab-2" hidden><h2>Your learning journey.</h2><div id="education-fields"></div><button class="outline-button" id="add-education">+ Add education</button></section><section id="panel-3" class="editor-panel" role="tabpanel" aria-labelledby="tab-3" hidden><h2>Your strengths, in a few words.</h2><label class="field-label">Skills<textarea class="field" data-field="skills" rows="6" placeholder="Separate your skills with commas, e.g. Project management, Python, Communication"></textarea></label><label class="field-label">Certifications, languages & additional information<textarea class="field" data-field="additional" rows="7" placeholder="Add relevant certifications, languages, awards, or volunteer work."></textarea></label></section>{kind==='cv'&&<section id="panel-4" class="editor-panel" role="tabpanel" aria-labelledby="tab-4" hidden><h2>Your academic contributions.</h2><label class="field-label">Research & publications<textarea class="field" data-field="research" rows="12" placeholder="Include publication titles, co-authors, journals, dates, and relevant research projects."></textarea></label></section>}</>}
<div class="editor-actions"><button id="previous-section" class="button secondary" disabled>← Back</button><button id="next-section" class="button primary">Next section →</button></div>
</div><div class="preview-zone"><div class="preview-toolbar"><span>LIVE PREVIEW</span><span>A4 · <span id="preview-template">The Modern</span></span></div><article id="document-preview" class="document-preview" aria-label="Document preview"></article></div></div><div class="notice">Saved on this device, in this browser. Download a backup to protect your work. For PDF, choose “Save as PDF” and disable browser headers and footers in the print dialog.</div>
</div></Layout>

