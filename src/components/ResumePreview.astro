---
const {variant='modern',name='Alex Morgan',role='Product Designer'}=Astro.props;
---
<div class:list={['resume-paper',variant]} aria-label={`${variant} resume template preview`}><div class="paper-heading"><div class="paper-monogram">{name.split(' ').map((x:string)=>x[0]).join('')}</div><h3>{name}</h3><p>{role}</p><div class="paper-contact">alex.morgan@example.com · San Francisco, CA</div></div><div class="paper-body"><section><h4>PROFILE</h4><p>Thoughtful, detail-oriented professional turning complex challenges into meaningful experiences. A collaborative problem solver with a passion for making an impact.</p><h4>EXPERIENCE</h4><strong>Senior {role}</strong><small>Studio North · 2022 — Present</small><ul><li>Led cross-functional initiatives from concept to launch.</li><li>Improved customer engagement by 32% through research and iteration.</li><li>Collaborated with a team of 8 to deliver exceptional results.</li></ul><strong>{role}</strong><small>Creative Collective · 2019 — 2022</small><ul><li>Built thoughtful solutions for a growing customer base.</li><li>Streamlined workflows and improved team efficiency.</li></ul><h4>EDUCATION</h4><strong>Bachelor of Arts, Design</strong><small>University of California · 2015 — 2019</small></section><section class="paper-skills"><h4>SKILLS</h4><p>Product strategy<br/>User research<br/>Visual design<br/>Prototyping<br/>Figma<br/>Collaboration</p><h4>HIGHLIGHTS</h4><p>Design leadership<br/>Systems thinking<br/>Accessibility</p></section></div></div>
